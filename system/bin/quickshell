#!/bin/sh
# Обёртка над quickshell.
#
# Движок собран против Qt 6.8 из ~/.local/opt/Qt (в Ubuntu 24.04 системный Qt
# версии 6.4.2, а Quickshell требует минимум 6.6 — см. QT_MIN_VERSION в его
# CMakeLists.txt). RPATH бинарника на этот Qt не указывает, поэтому пути к
# библиотекам, плагинам и QML-модулям задаются здесь.
# На Ubuntu Qt подсовывается из ~/.local/opt/Qt, потому что системный там
# 6.4.2. На Arch и производных (CachyOS) в репозиториях уже 6.9 — тогда
# каталога нет, и все подстановки ниже просто пропускаются.
QTROOT="$HOME/.local/opt/Qt/6.9.3/gcc_64"

# ~/.local/lib — libcava.so, собранная из исходников cava 0.9.1: в Ubuntu
# такой библиотеки нет (в Arch это AUR-пакет libcava), а плагин Clavis.Cava
# линкуется с ней. Версия именно 0.9.1: в 1.0.0 у cava_init появился лишний
# аргумент, и сборка плагина падает.
export LD_LIBRARY_PATH="$HOME/.local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
if [ -d "$QTROOT" ]; then
    export LD_LIBRARY_PATH="$QTROOT/lib:$LD_LIBRARY_PATH"
    export QT_PLUGIN_PATH="$QTROOT/plugins${QT_PLUGIN_PATH:+:$QT_PLUGIN_PATH}"
fi
# ~/.local/lib/qt6/qml — сюда встали нативные QML-модули темы Clavis
# (Clavis.Cava, Clavis.Niri, Clavis.Keyboard и остальные плагины).
export QML2_IMPORT_PATH="$HOME/.local/lib/qt6/qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
[ -d "$QTROOT/qml" ] && export QML2_IMPORT_PATH="$QML2_IMPORT_PATH:$QTROOT/qml"
export QML_IMPORT_PATH="$QML2_IMPORT_PATH"

# Оболочка Clavis вызывает утилиту key (key-cli) для буфера обмена, поиска
# файлов, записи экрана и системного монитора. В PATH процесса, запущенного
# из systemd, каталога ~/.local/bin нет, поэтому путь задаётся явно:
# Paths.qml читает CLAVIS_KEY, а PATH нужен остальным вызовам.
export PATH="$HOME/.local/bin:$PATH"
export CLAVIS_KEY="$HOME/.local/bin/key"

# Настройки этой оболочки лежат в самом репозитории (config/), а не в
# ~/.config/clavis: так они попадают в коммиты вместе с кодом и не остаются
# на одной машине. Путь вычисляется от самого скрипта, поэтому репозиторий
# можно положить куда угодно.
#
# Подменяем только для конфигурации "my". Апстримная копия Clavis, если её
# когда-нибудь запустят этой же обёрткой, останется при своих настройках.
self=$(readlink -f "$0" 2>/dev/null || echo "$0")
repo=${self%/system/bin/*}
case " $* " in
    *" -c my-quickshell-theme "*|*" --config my-quickshell-theme "*)
        [ -d "$repo/config" ] && export CLAVIS_CONFIG_HOME="$repo/config"
        ;;
esac

# Тема значков. Под niri некому сообщить её Qt: QIcon::themeName остаётся
# пустой, и не резолвится вообще ничего — проверка Quickshell.hasThemeIcon
# возвращала false даже для application-x-executable и folder. Отсюда пустые
# значки приложений в Spotlight и настройках и строки «Could not load icon»
# в логе на каждый запрос. Плагин gtk3 (берётся из того же ~/.local/opt/Qt,
# версия совпадает с движком) читает тему из настроек GTK — сейчас
# Yaru-prussiangreen-dark. Проверить:
#   qs -p <проба с Quickshell.hasThemeIcon("folder")>
export QT_QPA_PLATFORMTHEME="${QT_QPA_PLATFORMTHEME:-gtk3}"

# Qt Wayland при переключении фокуса между слоями оболочки пишет
# «QWaylandTextInputv3 … Try to disable surface … with focusing surface …».
# На работу ввода это не влияет, а из QML не чинится — глушим ровно эту
# категорию. Правила пользователя идут после и перекрывают наше.
export QT_LOGGING_RULES="qt.qpa.wayland.textinput=false${QT_LOGGING_RULES:+;$QT_LOGGING_RULES}"

# На гибридных ноутбуках libglvnd перебирает поставщиков EGL по порядку
# приоритета, и NVIDIA (10_nvidia.json) идёт раньше Mesa (50_mesa.json).
# Панель всё равно рисуется на встроенной Intel, а библиотеки NVIDIA при этом
# отображаются в память: замер показал 38 МБ и 51 отображение впустую.
# Оставляем только Mesa, если её файл на месте.
mesa_egl="/usr/share/glvnd/egl_vendor.d/50_mesa.json"
[ -f "$mesa_egl" ] && export __EGL_VENDOR_LIBRARY_FILENAMES="$mesa_egl"

# Движок: своей сборки или системный пакет. Имя quickshell без пути брать
# нельзя — в PATH по нему лежит эта же обёртка, получилась бы рекурсия.
for engine in "$HOME/.local/bin/quickshell-bin" /usr/bin/quickshell /usr/local/bin/quickshell; do
    [ -x "$engine" ] && exec "$engine" "$@"
done

echo "Не нашёл движок quickshell: ни ~/.local/bin/quickshell-bin, ни /usr/bin/quickshell" >&2
exit 1

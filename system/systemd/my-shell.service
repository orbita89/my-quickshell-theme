[Unit]
Description=Моя оболочка на Quickshell
Documentation=https://quickshell.org/
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# Память. У процесса 41 поток, и glibc заводит под каждый свою арену: с
# ограничением до двух RSS падает примерно на 7 МБ. Пороги trim и mmap
# заставляют возвращать освобождённое системе, а крупные блоки брать через
# mmap — ещё около 12 МБ. Замерять: scripts/memory-report.sh
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_TRIM_THRESHOLD_=131072
Environment=MALLOC_MMAP_THRESHOLD_=131072

ExecCondition=/bin/sh -c '[ -n "$WAYLAND_DISPLAY" ]'
# Запуск через обёртку ~/.local/bin/quickshell: она подставляет пути к Qt 6.9.3
# из ~/.local/opt/Qt, к QML-модулям темы и к libcava. Системного Qt (6.4.2)
# для Quickshell недостаточно — ему нужен минимум 6.6, а теме 6.9.
# Зачистка хвостов перед запуском. Оболочка держит keytop как долгоживущий
# поток данных для системного монитора. Если прошлый экземпляр оболочки умер
# резко или был запущен не этой службой, его keytop остаётся жить сиротой:
# один такой процесс с модулем gpu съедал 58% ядра и не давал заснуть
# дискретной видеокарте. KillMode=control-group убирает только тех, кто
# внутри cgroup службы, — а сироты из сессии остаются.
ExecStartPre=-/usr/bin/pkill --full "^%h/\\.local/bin/keytop-bin value stream"
ExecStart=%h/.local/bin/quickshell -c my-quickshell-theme
ExecReload=%h/.local/bin/quickshell -c my-quickshell-theme ipc call shell reload
ExecStopPost=-/usr/bin/pkill --full "^%h/\\.local/bin/keytop-bin value stream"
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target

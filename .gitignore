__pycache__/
*.pyc
*.orig

# Дерево сборки native-модулей (scripts/build-native.sh)
build/

# Файлы переводов создаёт сборка (lupdate по нашим же исходникам)
i18n/*
# Но русский перевод — рукотворный, его терять нельзя.
!i18n/clavis_ru_RU.ts
# И тот же i18n-плагин в core/ тоже игнорируется этим паттерном;
# это единственный core-плагин вне git, так что явно вернём его.
!core/plugin/i18n/
!core/plugin/i18n/**
/.idea/